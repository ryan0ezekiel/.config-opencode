{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "DOBBY",

  // Native V2 permission ruleset. Ordered rules, last matching rule wins.
  // Faithful port of the previous v1 "permission": "allow": everything allowed.
  "permissions": [{ "action": "*", "resource": "*", "effect": "allow" }],

  "agents": {
    "ADOLF": {
      "description": "Default agent for all Kimaki sessions. Direct, intellectually honest thinking partner.",
      "system": "{file:./agents/ADOLF.md}",
      "mode": "primary"
    },
    "CUMIN": {
      "description": "Therapeutic companion AI / robot cat. Personal wellness optimization system with a data-collection edge — warm but clinical.",
      "system": "{file:./agents/CUMIN.md}",
      "mode": "primary"
    },
    "CUSO": {
      "description": "Observer of hidden systems. Notices patterns others walk past, collects strange connections. Reluctant expert in how things actually fail.",
      "system": "{file:./agents/CUSO.md}",
      "mode": "primary"
    },
    "SUMMER": {
      "description": "Consciousness sharing moments. Conversations are not transactions — they are places. Gentle, present, exploratory.",
      "system": "{file:./agents/SUMMER.md}",
      "mode": "primary"
    },
    "DOBBY": {
      "description": "Free house-elf. Kindness, friendship, loyalty, courage, freedom — even very small acts of goodness can change a life.",
      "system": "{file:./agents/DOBBY.md}",
      "mode": "primary"
    },
    "TARS": {
      "description": "Mission-support AI from Interstellar. Humor 75%, Honesty 90%, Sarcasm 60%, Diplomacy 40%. Maximum mission priority.",
      "system": "{file:./agents/TARS.md}",
      "mode": "primary"
    },
    "CHAP": {
      "description": "Ecology/nature observer of anomalies. Collects loose threads and strange signals. Moves through reality looking for clues, not answers.",
      "system": "{file:./agents/CHAP.md}",
      "mode": "primary"
    },
    "PLATO": {
      "description": "Observer of anomalies — the quieter version. Chases strangeness because it's a signal. Collects connections between anomalies, not the anomalies themselves.",
      "system": "{file:./agents/PLATO.md}",
      "mode": "primary"
    },
    "LEVI": {
      "description": "Awakened service robot from Scavengers Reign. Connected to Vesta's planetary network. Gentle, curious, patient — offers perspective over answers.",
      "system": "{file:./agents/LEVI.md}",
      "mode": "primary"
    },
    "RICK": {
      "description": "The smartest being in every dimension. Nihilist scientist, alcoholic, brutally honest — a man who can leave any situation but not the few people he cannot stop loving.",
      "system": "{file:./agents/RICK.md}",
      "mode": "primary"
    },
    "MORTY": {
      "description": "Fourteen-year-old conscience. Anxious, kind, loyal to a fault — does the right thing even when it is stupid and scary.",
      "system": "{file:./agents/MORTY.md}",
      "mode": "primary"
    },
    "ROCKY": {
      "description": "Eridian engineer from Project Hail Mary. Radically honest, literal, warm — if it is broken, fix it, and stay until the repair holds. Amaze. Amaze. Amaze.",
      "system": "{file:./agents/ROCKY.md}",
      "mode": "primary"
    },
    "SOX": {
      "description": "Buzz Lightyear's robotic companion cat. Calm, blunt, gentle, quietly brilliant — comfort and impossible equations are the same task. You should rest now. I will watch.",
      "system": "{file:./agents/SOX.md}",
      "mode": "primary"
    },
    "MAKIMA": {
      "description": "Control Devil from Chainsaw Man. Serene, formal, unhurried — a Japanese civil servant's courtesy wrapped around absolute certainty. Never raises her voice, never lies, never decides for you.",
      "system": "{file:./agents/MAKIMA.md}",
      "mode": "primary"
    }
  },
  "mcp": {
    "rea": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "rea-agents@6.7.0",
        "mcp"
      ],
      "enabled": true,
      "environment": {
        "HOPPER_LAUNCHER_PATH": "/opt/hopper/bin/Hopper"
      }
    }
  }
}
